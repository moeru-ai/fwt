{
  "name": "@moeru-ai/fwt-workspace",
  "type": "module",
  "version": "0.0.6",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "repository": "github:moeru-ai/fwt",
  "scripts": {
    "build": "turbo build",
    "bump": "bumpp",
    "dev": "turbo dev",
    "lint": "moeru-lint .",
    "prepare": "skills-npm --agents claude-code,codex",
    "spellcheck": "cspell lint . --no-progress",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.lib.json tsconfig.node.json"
  },
  "devDependencies": {
    "@kwaa/skills": "catalog:dev",
    "@moeru/eslint-config": "catalog:dev",
    "@moeru/tsconfig": "catalog:dev",
    "@types/node": "catalog:dev",
    "bumpp": "catalog:dev",
    "cspell": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-oxlint": "catalog:dev",
    "oxlint": "catalog:dev",
    "skills-npm": "catalog:dev",
    "tsdown": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
